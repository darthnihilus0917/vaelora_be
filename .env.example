PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Settings -> API -> JWT Settings -> JWT Secret in the Supabase dashboard.
# Used to verify Supabase-issued access tokens locally (no network round-trip
# per request). Required for authenticate/requireRole middleware to work.
SUPABASE_JWT_SECRET=

# Cloudflare R2 (S3-compatible object storage) — used for product image uploads.
# Create an R2 API token (R2 -> Manage API Tokens) for the access key/secret.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL objects are served from (no trailing slash) — either the
# bucket's r2.dev URL or a custom domain bound to it. Uploaded image URLs are
# built as `${R2_PUBLIC_URL}/products/<productId>/<uuid>.<ext>`.
R2_PUBLIC_URL=
